# ─────────────────────────────────────────────────────────────
# Cliente (públicas, prefijo VITE_). Si se omiten, firebase.ts usa
# los valores públicos del proyecto `inevap-portal` por defecto.
# ─────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Stripe (pública)
VITE_STRIPE_PUBLISHABLE_KEY=

# ─────────────────────────────────────────────────────────────
# Servidor (SECRETAS, sin prefijo). Solo en funciones /api (Vercel).
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Firebase Admin SDK (service account JSON en base64)
FIREBASE_SERVICE_ACCOUNT_B64=
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# GoHighLevel (LeadConnector API v2)
GHL_API_TOKEN=
GHL_LOCATION_ID=
